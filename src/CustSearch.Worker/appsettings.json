{
  "ConnectionStrings": {
    "CustSearchDatabase": ""
  },
  "Worker": {
    "HeartbeatIntervalSeconds": 300
  },
  "IntegrationDispatcher": {
    "Enabled": true,
    "PollIntervalSeconds": 2,
    "BatchSize": 50
  },
  "ReportsExports": {
    "StoragePath": "App_Data/exports",
    "RetentionHours": 24,
    "DownloadTicketMinutes": 5,
    "DownloadSigningKey": "",
    "MaximumExportRows": 50000,
    "LeaseSeconds": 120
  },
  "ExportWorker": {
    "PollIntervalSeconds": 5,
    "BatchSize": 10
  },
  "OperationalPlatform": {
    "LeaseSeconds": 60,
    "RetentionBatchSize": 500,
    "RetentionPollMinutes": 60,
    "HeartbeatSeconds": 30,
    "RedisEnabled": false,
    "RedisEndpoint": "redis://localhost:6379",
    "AiServiceEnabled": false,
    "AiServiceHealthUrl": "https://localhost:8000/health/live"
  },
  "IntegrationSecrets": {},
  "Serilog": {
    "Using": ["Serilog.Sinks.Console", "Serilog.Sinks.File"],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    },
    "Enrich": ["FromLogContext"],
    "Properties": {
      "Application": "CustSearch.Worker"
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/worker-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14,
          "shared": true,
          "outputTemplate": "{Timestamp:O} [{Level:u3}] {Application} CorrelationId={CorrelationId} {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  }
}
