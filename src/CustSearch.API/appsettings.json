{
  "AllowedHosts": "localhost",
  "ConnectionStrings": {
    "CustSearchDatabase": ""
  },
  "Jwt": {
    "Issuer": "CustSearch.API",
    "Audience": "CustSearch.Web",
    "SigningKey": "",
    "AccessTokenLifetimeMinutes": 15,
    "RefreshTokenLifetimeDays": 7,
    "ClockSkewSeconds": 30,
    "RefreshCookie": {
      "Name": "custsearch_refresh",
      "Secure": true,
      "HttpOnly": true,
      "SameSite": "Strict",
      "Path": "/api/auth"
    }
  },
  "AuthRateLimiting": {
    "PermitLimit": 10
  },
  "ReverseProxy": {
    "Enabled": false,
    "KnownProxies": []
  },
  "AlertsRealtime": {
    "DispatcherEnabled": true,
    "PollIntervalSeconds": 2,
    "BatchSize": 50
  },
  "IntegrationSecurity": {
    "AllowedClockSkewSeconds": 300,
    "MaximumInboundBodyBytes": 262144
  },
  "CctvSecurity": {
    "AllowedClockSkewSeconds": 300,
    "MaximumBodyBytes": 131072
  },
  "CctvRuntime": {
    "DemoMode": false
  },
  "CctvServices": {},
  "RecognitionSecurity": {
    "Enabled": false,
    "EncryptionKeyReference": "",
    "EncryptionKeyBase64": "",
    "MinimumConfidence": 0.85,
    "MinimumQuality": 0.70,
    "AmbiguityDelta": 0.05,
    "RetentionDaysAfterWithdrawal": 30
  },
  "ReportsExports": {
    "StoragePath": "App_Data/exports",
    "RetentionHours": 24,
    "DownloadTicketMinutes": 5,
    "DownloadSigningKey": "",
    "MaximumExportRows": 50000,
    "LeaseSeconds": 120
  },
  "OperationalPlatform": {
    "LeaseSeconds": 60,
    "RetentionBatchSize": 500,
    "RetentionPollMinutes": 60,
    "HeartbeatSeconds": 30,
    "RedisEnabled": false,
    "RedisEndpoint": "redis://localhost:6379",
    "AiServiceEnabled": false,
    "AiServiceHealthUrl": "https://localhost:8000/health/live"
  },
  "IntegrationSecrets": {},
  "Serilog": {
    "Using": ["Serilog.Sinks.Console", "Serilog.Sinks.File"],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System.Net.Http.HttpClient": "Warning"
      }
    },
    "Enrich": ["FromLogContext"],
    "Properties": {
      "Application": "CustSearch.API"
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Application} {CorrelationId} {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/api-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14,
          "shared": true,
          "outputTemplate": "{Timestamp:O} [{Level:u3}] {Application} CorrelationId={CorrelationId} TraceId={TraceId} {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  }
}
